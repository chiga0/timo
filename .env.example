# Timo 本地环境变量示例（按需复制为 .env 或在启动命令中传入，所有项均可选）

# 本地数据与配置目录（默认 ~/.timo，建议保持在仓库目录之外）
# TIMO_HOME=~/.timo

# 在 127.0.0.1 开启 Web 工作台与 REST/SSE 控制面的端口
TIMO_HTTP_PORT=8790

# 本地回环 Session Token（留空则每次启动自动生成 256-bit 高熵随机令牌）
# TIMO_SESSION_TOKEN=

# 单次执行器运行超时（毫秒，默认 120000；大型仓库任务建议适当调大）
TIMO_RUN_DEADLINE_MS=600000

# 本地 Capability MCP Gateway 端口（默认 0 自动分配随机空闲端口）
# TIMO_MCP_PORT=0

# 可选：企业自建 Git / GitHub 平台凭据（推荐通过 Web「设置 → 平台与凭证」存入 ~/.timo/credentials.json 0600 保险箱）
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# ENTERPRISE_GIT_TOKEN=
